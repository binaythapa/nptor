from django.db.models import Q
from django.utils import timezone

from subscriptions.models import (
    Subscription,
    SubscriptionEntitlement,
)


def has_valid_subscription(user, exam):
    """
    Return True when the user has a valid subscription
    entitlement for the given exam.

    Rules:

    1. Track-level subscription:
       User owns an active entitlement for the exam's track.

    2. Exam-level subscription:
       User owns an active entitlement for the exam.
    """

    if not user or not user.is_authenticated:
        return False

    if not exam:
        return False

    current_time = timezone.now()

    track = exam.track

    # =========================================================
    # TRACK-LEVEL SUBSCRIPTION
    # =========================================================

    if (
        track
        and track.subscription_scope
        == "track"
    ):

        entitlement = (
            SubscriptionEntitlement.objects
            .select_related(
                "subscription",
                "track",
            )
            .filter(
                subscription__user=user,
                subscription__status=(
                    Subscription.STATUS_ACTIVE
                ),
                subscription__starts_at__lte=current_time,
                resource_type=(
                    SubscriptionEntitlement.RESOURCE_TRACK
                ),
                track=track,
                is_active=True,
            )
            .filter(
                Q(
                    subscription__expires_at__isnull=True
                )
                |
                Q(
                    subscription__expires_at__gt=current_time
                )
            )
            .first()
        )

        if not entitlement:
            return False

        return (
            entitlement.is_valid()
            and entitlement.subscription.is_valid()
        )

    # =========================================================
    # EXAM-LEVEL SUBSCRIPTION
    # =========================================================

    entitlement = (
        SubscriptionEntitlement.objects
        .select_related(
            "subscription",
            "exam",
        )
        .filter(
            subscription__user=user,
            subscription__status=(
                Subscription.STATUS_ACTIVE
            ),
            subscription__starts_at__lte=current_time,
            resource_type=(
                SubscriptionEntitlement.RESOURCE_EXAM
            ),
            exam=exam,
            is_active=True,
        )
        .filter(
            Q(
                subscription__expires_at__isnull=True
            )
            |
            Q(
                subscription__expires_at__gt=current_time
            )
        )
        .first()
    )

    if not entitlement:
        return False

    return (
        entitlement.is_valid()
        and entitlement.subscription.is_valid()
    )



from django.contrib.auth.decorators import login_required
from django.shortcuts import get_object_or_404, redirect
from django.contrib import messages
from django.utils import timezone

from quiz.models import Exam
from quiz.services.coupon_service import CouponService
from quiz.services.pricing_service import PricingService
from quiz.services.subscription_service import SubscriptionService
from quiz.services.payment_service import PaymentService


@login_required
def subscribe_exam(request, exam_id):
    exam = get_object_or_404(Exam, id=exam_id, is_published=True)

    coupon_code = request.POST.get("coupon")
    coupon = None

    if coupon_code:
        coupon, error = CouponService.validate_coupon(
            coupon_code,
            exam=exam
        )
        if error:
            messages.error(request, error)
            return redirect("quiz:exam_list")

    base_price = exam.price or 0
    final_price = PricingService.calculate_price(base_price, coupon)

    # 🔹 Determine expiry
    expires_at = None
    if coupon and coupon.extra_trial_days:
        expires_at = timezone.now() + timezone.timedelta(
            days=coupon.extra_trial_days
        )

    # 🔹 If payment required
    if final_price > 0:
        # ⛔ Integrate Razorpay / Stripe here
        payment_reference = "SIMULATED_PAYMENT_ID"

        PaymentService.record_payment(
            user=request.user,
            exam=exam,
            amount=final_price,
            reference_id=payment_reference
        )

    # 🔹 Grant subscription
    SubscriptionService.create_exam_subscription(
        user=request.user,
        exam=exam,
        expires_at=expires_at,
        payment_required=final_price > 0
    )

    if coupon:
        coupon.mark_used()

    messages.success(request, "Subscription activated!")
    return redirect("quiz:dashboard")

