# Local development environment for nptor.com
# Copy this file to .env and replace placeholder values.
# NEVER commit .env or real credentials.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-local-secret-key

DB_NAME=nptor_local
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost

EMAIL_HOST_USER=contact.nptor@gmail.com
# Use a Gmail App Password (16 characters), not the normal Gmail password.
EMAIL_HOST_PASSWORD=your_gmail_app_password
# Alternative variable supported by settings.py:
# GMAIL_APP_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=NPTOR <contact.nptor@gmail.com>
