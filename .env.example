# CV AI provider configuration
# Safe default: no AI API is called until a provider is explicitly selected.
CV_AI_PROVIDER=none
CV_AI_MODEL=
CV_AI_TIMEOUT_SECONDS=60

# Production recommendation: Gemini API free tier where available.
# Keep the real key out of Git and configure it in the cPanel/server environment.
GEMINI_API_KEY=

# Optional paid provider. Leave empty when using the free Gemini setup.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional local development provider.
OLLAMA_BASE_URL=http://127.0.0.1:11434
